# Microsoft 365 / Outlook
# Get from Azure portal → App registrations → your app → Certificates & Secrets
# Scopes needed: Mail.Read, Mail.Send, Mail.ReadWrite
OUTLOOK_ACCESS_TOKEN=
OUTLOOK_MAILBOX=tony@nofluffmarketing.onmicrosoft.com

# Gmail (optional — only if keeping Gmail before Workspace migration)
# Get from Google Cloud Console → Credentials → OAuth 2.0
# Scopes needed: https://www.googleapis.com/auth/gmail.readonly
#               https://www.googleapis.com/auth/gmail.compose
GMAIL_ACCESS_TOKEN=

# Future additional accounts — add as OUTLOOK_2, OUTLOOK_3, etc.
# OUTLOOK_MAILBOX_2=info@dfwhome.loans
# OUTLOOK_ACCESS_TOKEN_2=
