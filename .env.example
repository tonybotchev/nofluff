# Hermes Agent — Environment Variables
# Copy to .env and fill in your values. Never commit .env.

# GHL API Keys — Private Integration tokens from GHL Settings > Integrations > Private Integrations
GHL_NFM_API_KEY=                   # NFM location: tRk2nBMoIkO6EhFzr7jp
GHL_DHL_API_KEY=                   # DHL location: Jatw8uCMjEcPeIHP2M2z

# GHL Agency API Key (for subaccount creation)
