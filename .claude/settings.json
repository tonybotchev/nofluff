{
  "mcpServers": {
    "ghl-nfm": {
      "command": "ghl-mcp-server",
      "env": {
        "GHL_API_KEY": "${GHL_NFM_API_KEY}",
        "GHL_LOCATION_ID": "${GHL_NFM_LOCATION_ID}"
      }
    },
    "ghl-dhl": {
      "command": "ghl-mcp-server",
      "env": {
        "GHL_API_KEY": "${GHL_DHL_API_KEY}",
        "GHL_LOCATION_ID": "${GHL_DHL_LOCATION_ID}"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(git clone *)",
      "Bash(git pull *)",
      "Bash(curl *:https://services.leadconnectorhq.com/*)",
      "Bash(curl *:https://api.gohighlevel.com/*)",
      "Bash(hermes *)",
      "Bash(ghl-mcp-server *)"
    ]
  }
}
